    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst WIDE_SPREAD_BPS_THRESHOLD = 2.0;\nconst CRITICAL_SPREAD_BPS_THRESHOLD = 5.0;\n\nconst STALE_QUOTE_SECONDS_THRESHOLD = 600;\nconst CRITICAL_STALE_SECONDS_THRESHOLD = 1800;\n\nconst anomalies = [];\n\nfor (const item of items) {\n    const quote = item.json;\n\n    const symbol = quote.symbol;\n    const bid = Number(quote.bid);\n    const ask = Number(quote.ask);\n    const midPrice = Number(quote.mid_price);\n    const spread = Number(quote.spread);\n    const observedAt = new Date(quote.observed_at);\n\n    // Wide spread check\n    const spreadBps = (spread / midPrice) * 10000;\n\n    if (spreadBps > WIDE_SPREAD_BPS_THRESHOLD) {\n        anomalies.push({\n            json: {\n                symbol,\n                anomaly_type: 'wide_spread',\n                severity:\n                    spreadBps > CRITICAL_SPREAD_BPS_THRESHOLD\n                        ? 'critical'\n                        : 'warning',\n                metric_value: Number(spreadBps.toFixed(8)),\n                threshold_value: WIDE_SPREAD_BPS_THRESHOLD,\n                details: {\n                    bid,\n                    ask,\n                    mid_price: midPrice,\n                    spread,\n                    spread_bps: Number(spreadBps.toFixed(8)),\n                    source: quote.source,\n                    observed_at: quote.observed_at\n                }\n            }\n        });\n    }\n\n    // Stale quote check\n    const quoteAgeSeconds =\n        (Date.now() - observedAt.getTime()) / 1000;\n\n    if (\n        Number.isFinite(quoteAgeSeconds) &&\n        quoteAgeSeconds > STALE_QUOTE_SECONDS_THRESHOLD\n    ) {\n        anomalies.push({\n            json: {\n                symbol,\n                anomaly_type: 'stale_quote',\n                severity:\n                    quoteAgeSeconds > CRITICAL_STALE_SECONDS_THRESHOLD\n                        ? 'critical'\n                        : 'warning',\n                metric_value: Number(quoteAgeSeconds.toFixed(8)),\n                threshold_value: STALE_QUOTE_SECONDS_THRESHOLD,\n                details: {\n                    quote_age_seconds: Math.round(quoteAgeSeconds),\n                    observed_at: quote.observed_at,\n                    source: quote.source\n                }\n            }\n        });\n    }\n}\n\nreturn anomalies;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
