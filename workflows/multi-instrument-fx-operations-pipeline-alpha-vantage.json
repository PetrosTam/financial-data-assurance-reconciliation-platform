    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH previous_quote AS (\n    SELECT\n        mid_price,\n        observed_at\n    FROM fx_quotes\n    WHERE symbol = $1\n      AND observed_at < $2::timestamptz\n    ORDER BY observed_at DESC\n    LIMIT 1\n)\nSELECT\n    $1::text AS symbol,\n    'extreme_price_movement'::text AS anomaly_type,\n\n    CASE\n        WHEN ABS(($3::numeric - mid_price) / mid_price) * 10000 > 50\n            THEN 'critical'\n        ELSE 'warning'\n    END AS severity,\n\n    ROUND(\n        ABS(($3::numeric - mid_price) / mid_price) * 10000,\n        8\n    ) AS metric_value,\n\n    20.0::numeric AS threshold_value,\n\n    jsonb_build_object(\n        'previous_mid_price', mid_price,\n        'current_mid_price', $3::numeric,\n        'movement_bps',\n            ROUND(\n                ABS(($3::numeric - mid_price) / mid_price) * 10000,\n                8\n            ),\n        'previous_observed_at', observed_at,\n        'current_observed_at', $2::timestamptz\n    ) AS details\n\nFROM previous_quote\n\nWHERE\n    ABS(($3::numeric - mid_price) / mid_price) * 10000 > 20;",
        "options": {
          "queryReplacement": "={{ $json.symbol }}, {{ $json.observed_at }}, {{ $json.mid_price }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
