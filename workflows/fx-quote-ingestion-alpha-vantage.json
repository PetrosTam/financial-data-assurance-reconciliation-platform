{
  "name": "FX Quote Ingestion - Alpha Vantage",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item) => {\n    const payload = item.json;\n    const rate = payload['Realtime Currency Exchange Rate'];\n\n    // Validate that Alpha Vantage returned the expected response\n    if (!rate) {\n        const apiMessage =\n            payload['Error Message'] ||\n            payload['Information'] ||\n            payload['Note'] ||\n            'Missing Realtime Currency Exchange Rate data';\n\n        throw new Error(`Invalid Alpha Vantage response: ${apiMessage}`);\n    }\n\n    const fromCurrency = rate['1. From_Currency Code'];\n    const toCurrency = rate['3. To_Currency Code'];\n    const bid = Number(rate['8. Bid Price']);\n    const ask = Number(rate['9. Ask Price']);\n    const lastRefreshed = rate['6. Last Refreshed'];\n\n    // Validate required fields\n    if (!fromCurrency || !toCurrency) {\n        throw new Error('Missing currency code in Alpha Vantage response');\n    }\n\n    if (!Number.isFinite(bid) || !Number.isFinite(ask)) {\n        throw new Error('Bid or ask price is not a valid number');\n    }\n\n    if (bid <= 0 || ask <= 0) {\n        throw new Error('Bid and ask prices must be greater than zero');\n    }\n\n    if (ask < bid) {\n        throw new Error(`Invalid quote: ask (${ask}) is lower than bid (${bid})`);\n    }\n\n    if (!lastRefreshed) {\n        throw new Error('Missing quote timestamp');\n    }\n\n    const observedAt = new Date(\n        lastRefreshed.replace(' ', 'T') + 'Z'\n    );\n\n    if (Number.isNaN(observedAt.getTime())) {\n        throw new Error(`Invalid quote timestamp: ${lastRefreshed}`);\n    }\n\n    // Normalize provider-specific data into the internal FX schema\n    const midPrice = Number(((bid + ask) / 2).toFixed(8));\n    const spread = Number((ask - bid).toFixed(8));\n\n    return {\n        json: {\n            symbol: `${fromCurrency}${toCurrency}`,\n            provider_instrument_id: null,\n            bid,\n            ask,\n            mid_price: midPrice,\n            spread,\n            source: 'alpha-vantage',\n            observed_at: observedAt.toISOString(),\n            raw_payload: payload\n        }\n    };\n});"
      },
